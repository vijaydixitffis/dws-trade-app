<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.dws.trade</groupId>
  <artifactId>dws-trade-app</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>dws-trade-app</name>
  <description>Trade store: capture, stream, validate, store and expire trades</description>

  <modules>
    <module>trade-common</module>
    <module>trade-security</module>
    <module>trade-capture-service</module>
    <module>trade-processor-service</module>
    <module>trade-query-service</module>
    <module>trade-simulator</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <shedlock.version>7.11.0</shedlock.version>
    <jacoco.version>0.8.13</jacoco.version>
    <dependency-check.version>12.1.3</dependency-check.version>
    <coverage.minimum>0.80</coverage.minimum>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.dws.trade</groupId>
        <artifactId>trade-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.dws.trade</groupId>
        <artifactId>trade-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.javacrumbs.shedlock</groupId>
        <artifactId>shedlock-spring</artifactId>
        <version>${shedlock.version}</version>
      </dependency>
      <dependency>
        <groupId>net.javacrumbs.shedlock</groupId>
        <artifactId>shedlock-provider-jdbc-template</artifactId>
        <version>${shedlock.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Show every compiler warning (deprecation, unchecked, serialization...) so none goes unnoticed. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <showWarnings>true</showWarnings>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <!-- Annotation processors are not used; the messages about them add only noise. -->
            <arg>-Xlint:-processing</arg>
            <!-- A new warning fails the build, so the code stays warning-free. -->
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <!-- Coverage gate: the build fails when line coverage drops below ${coverage.minimum} -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
            <exclude>**/*Application.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn -Psecurity-scan verify : OWASP Dependency-Check, fails on CVSS >= 9 (critical) -->
    <profile>
      <id>security-scan</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check.version}</version>
            <configuration>
              <failBuildOnCVSS>9</failBuildOnCVSS>
              <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
              <formats>
                <format>HTML</format>
                <format>JSON</format>
              </formats>
            </configuration>
            <executions>
              <execution>
                <goals><goal>aggregate</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
