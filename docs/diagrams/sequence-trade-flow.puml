@startuml sequence-trade-flow
title Trade Store - Capture and Processing
autonumber
skinparam maxMessageSize 150
skinparam ParticipantPadding 8

participant "Simulator" as sim
participant "Capture API" as cap
queue "Kafka" as k
participant "Processor" as proc
database "PostgreSQL" as pg

sim -> cap : POST /api/v1/trades (Basic auth)
alt invalid (400) or maturityDate < today (422)
  cap -> k : trades.rejected (422 only)
  cap --> sim : 400 or 422
else valid
  cap -> k : trades.inbound (key = tradeId)
  cap --> sim : 202 Accepted
end

k -> proc : consume record
alt unreadable JSON
  proc -> k : trades.inbound.DLT
else readable but fails validation
  proc -> k : trades.rejected (INVALID_TRADE)
else valid trade
  group one database transaction
    proc -> pg : claim version in trade_latest\nWHERE latest_version <= incoming
    alt 1 row affected
      proc -> pg : upsert trade (trade_id, version)
      proc -> pg : insert outbox row
      proc -> pg : commit
    else 0 rows (lower version)
      proc -> pg : rollback
    end
  end
  opt rolled back
    proc -> k : trades.rejected\n(LOWER_VERSION or MATURITY_DATE_PASSED)
  end
end
proc -> k : commit offset
@enduml
