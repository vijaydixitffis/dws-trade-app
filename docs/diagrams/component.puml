@startuml component
title Trade Store - Component View
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam nodesep 40
skinparam ranksep 50
top to bottom direction

rectangle "Clients" as clients {
  actor "Operations user" as user
  component "trade-dashboard-ui\n(React)" as ui
  component "trade-simulator\n(Spring Boot)" as sim
}

component "trade-capture-service\n(REST: 202 / 422)" as capture

rectangle "Apache Kafka" as kafka {
  queue "trades.inbound\n(key = tradeId)" as inbound
  queue "trades.events" as events
  queue "trades.rejected" as rejected
  queue "trades.inbound.DLT" as dlt
  inbound -[hidden]right-> rejected
  rejected -[hidden]right-> events
  events -[hidden]right-> dlt
}

rectangle "Processing and read side" as services {
  component "trade-processor-service\n(rules, expiry job)" as processor
  component "trade-query-service\n(REST + SSE)" as query
  processor -[hidden]right-> query
}

rectangle "Storage" as storage {
  database "PostgreSQL\ntrade store" as pg
  database "MongoDB\nevents, rejections" as mongo
  pg -[hidden]right-> mongo
}

user -right-> ui
ui -right-> sim : start / stop
ui -[norank]-> query : REST, SSE
sim -down-> capture : POST trades
capture --> inbound : valid trade
capture --> rejected : past maturity
inbound --> processor
processor --> events : ACCEPTED, REPLACED, EXPIRED
processor --> rejected : lower version
processor --> dlt : technical failure
processor -down-> pg : atomic version check
events --> query
rejected --> query
query -down-> mongo : project
query -down-> pg : read trades
@enduml
