# Builds one Spring Boot service. Build context is the repository root.
#   docker build -f deploy/Dockerfile.service --build-arg MODULE=trade-capture-service .
# Base images are pinned by digest; Dependabot proposes updates.
FROM maven:3.9-eclipse-temurin-26@sha256:b2c1ad85954592f9928e84327c65201f308ad9b5d8ed7d5b823717c97bf23fbb AS build
ARG MODULE
WORKDIR /src
COPY pom.xml .
COPY trade-common trade-common
COPY trade-security trade-security
COPY trade-capture-service trade-capture-service
COPY trade-processor-service trade-processor-service
COPY trade-query-service trade-query-service
COPY trade-simulator trade-simulator
RUN --mount=type=cache,target=/root/.m2 mvn -q -B -pl ${MODULE} -am package -DskipTests -Djacoco.skip=true \
 && cp ${MODULE}/target/${MODULE}-*.jar /app.jar

FROM eclipse-temurin:21-jre@sha256:18bb4a91a3dea3f03ee31d3755af34dfb40f904fc77ab56cdc2f092e32fff9c2
RUN useradd --system --no-create-home app
USER app
COPY --from=build /app.jar /app.jar
ENTRYPOINT ["java", "-jar", "/app.jar"]
