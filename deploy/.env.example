# Copy to deploy/.env and change before any use beyond a demo. Every value has a demo default.

# HTTP Basic account used by the dashboard login, every service and the simulator.
TRADE_SECURITY_USERNAME=admin
TRADE_SECURITY_PASSWORD=admin@2026!

# PostgreSQL: the owner account (processor) and the read-only account (query service).
POSTGRES_PASSWORD=trade
TRADE_RO_PASSWORD=trade_ro

# Time zone that defines "today". Empty = the server's own zone, for example Europe/London.
TRADE_BUSINESS_ZONE=
